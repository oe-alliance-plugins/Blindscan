msgid "Symbol rate values are in megasymbols; enter a value between %d and %d"
msgstr "Значения символьной скорости в мегасимволах. Введите значение от %d до %d."

#: ../plugin.py:617
msgid "Symbol rate values are in megasymbols; enter a value between 1 and 44"
msgstr "Значения символьной скорости в мегасимволах. Введите значение от 1 до 44."

#: ../plugin.py:618
msgid "Symbol rate values are in megasymbols; enter a value between 2 and 45"
msgstr "Значения символьной скорости в мегасимволах. Введите значение от 2 до 45."

#: ../dmmBlindScan.py:877 ../plugin.py:1298
msgid "The blindscan run was cancelled by the user."
msgstr "Слепой поиск был прерван пользователем."

#: ../plugin.py:616
#, python-format
