msgstr "Пожалуйста, настройте свои тюнеры."

#: ../plugin.py:616
msgid "Polarisation"
msgstr "Поляризация"

#: ../dmmBlindScan.py:669
msgid "Polarisation, select horizontal, vertical or both."
msgstr "Выберите горизонтальную, вертикальную или обе поляризации."

#: ../dmmBlindScan.py:669
msgid "Polarization"
msgstr "Поляризация"

