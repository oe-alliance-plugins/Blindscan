"%s"

#: ../dmmBlindScan.py:665 ../plugin.py:589
msgid "Search type"
msgstr "Тип поиска"

#: ../dmmBlindScan.py:530
msgid "Searching for active satellite transponders..."
msgstr "Поиск действующих транспондеров..."

#: ../dmmBlindScan.py:643 ../plugin.py:569
msgid "Select a tuner that is configured for the satellite you wish to search"
msgstr "Выберите тюнер настроенный на тот спутник, который хотите сканировать"

#: ../plugin.py:188
msgid "Select all"
msgstr "Выбрать все"

#: ../dmmBlindScan.py:673
msgid "Select between 1 and 5. Higher numbers give more accurat search results."
msgstr "Задайте значение от 1 до 5. Более высокое число дает более точные результаты."

#: ../dmmBlindScan.py:652 ../plugin.py:577
msgid "Select the satellite you wish to search"
msgstr "Выберите спутник, который хотите сканировать"

#: ../plugin.py:186
msgid ""
"Select transponders and press green to scan.\n"
"Press yellow to select all transponders and blue to deselect all."
msgstr ""
"Выберите транспондеры и нажмите зелёную кнопку для сканирования.\n"
"Нажмите жёлтую кнопку, чтобы выбрать все транспондеры или синюю для снятия выделения."

#: ../dmmBlindScan.py:114
msgid "Service searching to be started MANUALLY by the user. To change this press green."
msgstr "Поиск каналов нужно начать ВРУЧНУЮ. Чтобы изменить это, нажмите зелёную кнопку."

#: ../dmmBlindScan.py:116
msgid "Service searching will start AUTOMATICALLY. To change this press green."
msgstr "Поиск каналов начнётся АВТОМАТИЧЕСКИ. Чтобы изменить это, нажмите зелёную кнопку."

#: ../plugin.py:615
msgid "Smaller steps takes longer but scan is more thorough"
msgstr "Более короткие шаги требуют больше времени, но сканирование будет более тщательным"

#: ../dmmBlindScan.py:484 ../plugin.py:440
msgid "Sorry, this tuner is in use."
msgstr "Извините, этот тюнер занят."

#: ../dmmBlindScan.py:667
msgid "Start frequency"
msgstr "Начальная частота сканирования"

#: ../dmmBlindScan.py:670
msgid "Start symbol rate"
