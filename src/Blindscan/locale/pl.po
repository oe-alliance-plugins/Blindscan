#: ../dmmBlindScan.py:486
msgid ""
"\n"
"A recording is in progress."
msgstr ""
"\n"
"Nagrywanie jest w toku."

#: ../plugin.py:565
msgid ""
"\n"
"The second slot of this dual tuner may not support blind scan."
msgstr ""
"\n"
"Drugie gniazdo tego podwójnego tunera może nie obsługiwać skanowania w ciemno."

#: ../plugin.py:567
msgid ""
"\n"
"You must use the power adapter."
msgstr ""
"\n"
"Należy użyć zasilacza."

#: ../plugin.py:1005
msgid "   Starting Sundtek hardware blind scan."
msgstr "   Uruchamianie skanowania w ciemno sprzętu Sundtek."

#: ../plugin.py:738
msgid " tuner."
msgstr " tuner."

#: ../plugin.py:589
msgid "\"channel scan\" searches for channels and saves them to your receiver; \"transponder scan\" does a transponder search and displays the results allowing user to select some or all transponder. Both options save the results in satellites.xml format under /tmp"
msgstr "„skanowanie kanałów” wyszukuje kanały i zapisuje je w odbiorniku; „skanowanie transpondera\" przeszukuje transponder i wyświetla wyniki, pozwalając użytkownikowi wybrać niektóre lub wszystkie transpondery. Obie opcje zapisują wyniki w formacie satellites.xml pod /tmp"

#: ../dmmBlindScan.py:665
msgid "\"scan for channels\" searches for channels and saves them to your receiver; \"Save to XML\" does a transponder search and saves the results in satellites.xml format and stores it in /tmp"
msgstr "„skanuj kanały” wyszukuje kanały i zapisuje je w odbiorniku; „Zapisz w XML” wykonuje wyszukiwanie transponderów i zapisuje wyniki w formacie satellites.xml i przechowuje je w /tmp"

#: ../dmmBlindScan.py:347
#, python-format
msgid "%d transponder(s) found"
msgstr "Znaleziono %d transponderów"

#: ../dmmBlindScan.py:322
#, python-format
msgid "%d transponders found at %d:%02d min"
msgstr "Znaleziono %d transponderów w %d:%02d min"

#: ../dmmBlindScan.py:352
#, python-format
msgid "%d:%02d/%d:%02dmin"
msgstr "%d:%02d/%d:%02dmin"

#: ../dmmBlindScan.py:320
#, python-format
msgid "%dMHz scanned"
msgstr "Przeskanowano %dMHz"

#: ../dmmBlindScan.py:673
msgid "Accuracy (higher is better)"
msgstr "Dokładność (im wyższa tym lepsza)"

#: ../dmmBlindScan.py:87
msgid "Auto / Manual"
msgstr "Automatyczny / Manualny"

#: ../plugin.py:1616 ../plugin.py:1625
msgid "Blind scan"
msgstr "Blind scan"

#: ../dmmBlindScan.py:555
msgid "Blind scan for DVB-S2 tuners"
msgstr "Blind scan dla tunerów DVB-S2"

#: ../dmmBlindScan.py:79 ../plugin.py:158
msgid "Blind scan state"
msgstr "Stan Blind scan"

#: ../plugin.py:232
msgid "Blindscan"
msgstr "Blindscan"

#: ../plugin.py:907 ../plugin.py:916 ../plugin.py:946 ../plugin.py:954
#: ../plugin.py:968
#, python-format
msgid "Blindscan executable not found '%s'!"
msgstr "Nie znaleziono pliku wykonywalnego Blindscan '%s'!"

#: ../plugin.py:738
msgid "Blindscan is not supported in "
msgstr "Funkcja Blindscan nie jest obsługiwana w "

#: ../dmmBlindScan.py:681 ../plugin.py:625
msgid "CAUTION: If you select \"yes\" the scan will not remove \"duplicated\" transponders from the list. Default is \"no\". Only change this if you understand why you are doing it."
msgstr "UWAGA: Jeśli wybierzesz „tak”, skanowanie nie usunie „zduplikowanych” transponderów z listy. Domyślnie jest to „nie”. Zmień to tylko wtedy, gdy rozumiesz, dlaczego to robisz."

#: ../dmmBlindScan.py:680 ../plugin.py:624
msgid "CAUTION: If you select \"yes\" the scan will not sync with transponders listed in satellites.xml. Default is \"no\". Only change this if you understand why you are doing it."
msgstr "UWAGA: Jeśli wybierzesz „tak”, skanowanie nie zostanie zsynchronizowane z transponderami wymienionymi w pliku satellites.xml. Domyślnie jest to „nie”. Zmień to tylko wtedy, gdy rozumiesz, dlaczego to robisz."

#: ../plugin.py:599
msgid "CAUTION: Only select \"inverted\" if you are using an inverted LNB (i.e. an LNB where the local oscillator frequency is greater than the scan frequency). Default is \"normal\". Only change this if you understand why you are doing it."
msgstr "UWAGA: Wybierz \"odwrotny\" tylko wtedy, gdy używasz odwróconego LNB (tj. LNB, w którym częstotliwość lokalnego oscylatora jest większa niż częstotliwość skanowania). Domyślnie jest to \"normalna\". Zmień to tylko wtedy, gdy rozumiesz, dlaczego to robisz."

#: ../dmmBlindScan.py:86 ../plugin.py:163
msgid "Cancel"
msgstr "Anuluj"

#: ../dmmBlindScan.py:675 ../plugin.py:619
msgid "Clear before scan"
msgstr "Wyczyść przed skanowaniem"

#: ../plugin.py:1008
#, python-format
msgid ""
"Current Status: %d/%d\n"
"Satellite: %s\n"
"Polarization: %s  Frequency range: %d - %d MHz  Symbol rates: %d - %d MSym/s"
msgstr ""
"Aktualny status: %d/%d\n"
"Satelita: %s\n"
"Polaryzacja: %s Zakres częstotliwości: %d - %d MHz Szybkości symboli: %d - %d MSym/s"

#: ../dmmBlindScan.py:785
msgid "DVB-S + DVB-S2"
msgstr "DVB-S + DVB-S2"

#: ../dmmBlindScan.py:786
msgid "DVB-S only"
msgstr "Tylko DVB-S"

#: ../plugin.py:189
msgid "Deselect all"
msgstr "Odznacz wszystko"

#: ../dmmBlindScan.py:681 ../plugin.py:625
msgid "Disable remove duplicates"
msgstr "Wyłącz usuwanie duplikatów"

#: ../dmmBlindScan.py:680 ../plugin.py:624
msgid "Disable sync with known transponders"
msgstr "Wyłącz synchronizację ze znanymi transponderami"

#: ../dmmBlindScan.py:599 ../plugin.py:306
msgid "Exit"
msgstr "Wyjście"

#: ../dmmBlindScan.py:682 ../plugin.py:626
msgid "Filter out adjacent satellites"
msgstr "Odfiltruj sąsiadujące satelity"

#: ../dmmBlindScan.py:667 ../dmmBlindScan.py:668 ../plugin.py:596
#: ../plugin.py:597 ../plugin.py:608 ../plugin.py:609 ../plugin.py:611
#: ../plugin.py:612
#, python-format
msgid "Frequency values must be between %d MHz and %d MHz"
msgstr "Wartości częstotliwości muszą mieścić się w przedziale od %d MHz do %d MHz"

#: ../plugin.py:593 ../plugin.py:594
#, python-format
msgid "Frequency values must be between %d MHz and %d MHz (C-band)"
msgstr "Wartości częstotliwości muszą mieścić się w przedziale od %d MHz do %d MHz (pasmo C)"

#: ../dmmBlindScan.py:540
#, python-format
msgid "Hardware blind scan is not supported by this tuner (%s)!"
msgstr "Ten tuner (%s) nie obsługuje sprzętowego skanowania!"

#: ../dmmBlindScan.py:675 ../plugin.py:619
msgid "If you select \"yes\" all channels on the satellite being searched will be deleted before starting the current search, yes (keep feeds) means the same but hold all feed services/transponders."
msgstr "Jeżeli wybierzesz „tak”, wszystkie kanały na przeszukiwanym satelicie zostaną usunięte przed rozpoczęciem bieżącego wyszukiwania, tak (zachowaj transmisje) oznacza to samo, ale zachowane zostaną wszystkie usługi transponderów/transpondery."

#: ../dmmBlindScan.py:676 ../plugin.py:620
msgid "If you select \"yes\" the scan will only save channels that are not encrypted; \"no\" will find encrypted and non-encrypted channels."
msgstr "Jeżeli wybierzesz „tak”, skanowanie zapisze tylko kanały niezaszyfrowane; jeżeli wybierzesz „nie”, zostaną znalezione kanały zaszyfrowane i nieszyfrowane."

#: ../dmmBlindScan.py:677 ../plugin.py:621
msgid "If you select \"yes\" the scan will only search transponders not listed in satellites.xml"
msgstr "Jeżeli wybierzesz 'tak' skanowane będą tylko transpondery nie wymienione w satellites.xml"

#: ../plugin.py:882
msgid "It seems manufacturer does not support blind scan for this tuner."
msgstr "Wygląda na to, że producent nie obsługuje skanowania w ciemno dla tego tunera."

#: ../plugin.py:599
msgid "LNB inversion"
msgstr "Inwersja LNB"

#: ../dmmBlindScan.py:658 ../plugin.py:583
msgid "LNB of current satellite not compatible with plugin"
msgstr "Konwerter LNB bieżącego satelity nie jest kompatybilny z wtyczką"

#: ../plugin.py:1009
msgid ""
"Looking for available transponders.\n"
"This will take a long time, please be patient."
msgstr ""
"Szukam dostępnych transponderów.\n"
"To potrwa długo, proszę o cierpliwość."

#: ../plugin.py:1292
msgid ""
"No new transponders found! \n"
"\n"
"Only transponders already listed in satellites.xml \n"
"have been found for those search parameters!"
msgstr ""
"Nie znaleziono nowych transponderów!\n"
"\n"
"Znaleziono tylko transpondery wymienione w satellites.xml\n"
"dla tych parametrów wyszukiwania!"

#: ../dmmBlindScan.py:879 ../plugin.py:1296
msgid "No transponders were found for those search parameters!"
msgstr "Nie znaleziono transponderów dla podanych parametrów wyszukiwania!"

#: ../dmmBlindScan.py:532
msgid "Nothing to scan! Press Exit!"
msgstr "Nic do zeskanowania! Naciśnij Wyjście!"

#: ../dmmBlindScan.py:676 ../plugin.py:620
msgid "Only free scan"
msgstr "Skanuj tylko niekodowane"

#: ../dmmBlindScan.py:677 ../plugin.py:621
msgid "Only scan unknown transponders"
msgstr "Skanuj tylko nieznane transpondery"

#: ../plugin.py:322 ../plugin.py:1439
msgid "Open xml file"
msgstr "Otwórz plik xml"

#: ../dmmBlindScan.py:606 ../plugin.py:315
msgid "Please setup your tuner configuration."
msgstr "Proszę skonfigurować tuner."

#: ../plugin.py:616
msgid "Polarisation"
msgstr "Polaryzacja"

#: ../dmmBlindScan.py:669
msgid "Polarisation, select horizontal, vertical or both."
msgstr "Polaryzacja: wybierz polaryzację poziomą, pionową lub obie."

#: ../dmmBlindScan.py:669
msgid "Polarization"
msgstr "Polaryzacja"

#: ../dmmBlindScan.py:609
msgid "Press OK to start the scan."
msgstr "Naciśnij OK, aby rozpocząć skanowanie."

#: ../dmmBlindScan.py:122
msgid "Press green to start service searching."
msgstr "Naciśnij zielony przycisk, aby rozpocząć wyszukiwanie usług."

#: ../plugin.py:308 ../plugin.py:1466 ../plugin.py:1476
msgid "Restore defaults"
msgstr "Przywróć ustawienia domyślne"

