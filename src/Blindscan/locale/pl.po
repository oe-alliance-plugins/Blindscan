"Search completed. %d transponders found.\n"
"\n"
"Details saved in:\n"
"%s"
msgstr ""
"Wyszukiwanie zakończone. Znaleziono %d transponderów.\n"
"\n"
"Szczegóły zapisane w:\n"
"%s"

#: ../dmmBlindScan.py:665 ../plugin.py:589
msgid "Search type"
msgstr "Typ skanowania"

#: ../dmmBlindScan.py:530
msgid "Searching for active satellite transponders..."
msgstr "Wyszukiwanie aktywnych transponderów satelitarnych..."

#: ../dmmBlindScan.py:643 ../plugin.py:569
msgid "Select a tuner that is configured for the satellite you wish to search"
msgstr "Wybierz tuner skonfigurowany dla satelity, którego chcesz przeszukać"

#: ../plugin.py:188
msgid "Select all"
msgstr "Zaznacz wszystko"

#: ../dmmBlindScan.py:673
msgid "Select between 1 and 5. Higher numbers give more accurat search results."
msgstr "Wybierz od 1 do 5. Większe liczby dają dokładniejsze wyniki wyszukiwania."

#: ../dmmBlindScan.py:652 ../plugin.py:577
msgid "Select the satellite you wish to search"
msgstr "Wybierz satelitę, którą chcesz skanować"

#: ../plugin.py:186
msgid ""
"Select transponders and press green to scan.\n"
"Press yellow to select all transponders and blue to deselect all."
msgstr ""
"Wybierz transpondery i naciśnij zielony, aby zeskanować.\n"
"Naciśnij żółty, aby wybrać wszystkie transpondery i niebieski, aby odznaczyć wszystkie."

#: ../dmmBlindScan.py:114
msgid "Service searching to be started MANUALLY by the user. To change this press green."
msgstr "Wyszukiwanie usług, które ma zostać uruchomione RĘCZNIE przez użytkownika. Aby to zmienić, naciśnij zielony."

#: ../dmmBlindScan.py:116
msgid "Service searching will start AUTOMATICALLY. To change this press green."
msgstr "Wyszukiwanie usług rozpocznie się AUTOMATYCZNIE. Aby to zmienić, naciśnij zielony."

#: ../plugin.py:615
msgid "Smaller steps takes longer but scan is more thorough"
msgstr "Mniejsze kroki zajmują więcej czasu, ale skanowanie jest dokładniejsze"

#: ../dmmBlindScan.py:484 ../plugin.py:440
msgid "Sorry, this tuner is in use."
msgstr "Przepraszamy, ten tuner jest w użyciu."

#: ../dmmBlindScan.py:667
msgid "Start frequency"
msgstr "Częstotliwość początkowa"

#: ../dmmBlindScan.py:670
msgid "Start symbol rate"
msgstr "Początkowa szybkość symboli"

#: ../plugin.py:1184
#, python-format
msgid "Step %d %d:%02d min"
msgstr "Krok %d %d:%02d min"

#: ../dmmBlindScan.py:668
msgid "Stop frequency"
msgstr "Częstotliwość zatrzymania"

#: ../dmmBlindScan.py:671
msgid "Stop symbol rate"
msgstr "Zatrzymaj szybkość symboli"

#: ../dmmBlindScan.py:670 ../dmmBlindScan.py:671
#, python-format
msgid "Symbol rate values are in megasymbols; enter a value between %d and %d"
msgstr "Wartości szybkości symboli są podane w mega symbolach; wprowadź wartość pomiędzy %d a %d"

#: ../plugin.py:617
msgid "Symbol rate values are in megasymbols; enter a value between 1 and 44"
msgstr "Wartości szybkości symboli są podane w mega symbolach; wprowadź wartość od 1 do 44"

#: ../plugin.py:618
msgid "Symbol rate values are in megasymbols; enter a value between 2 and 45"
msgstr "Wartości szybkości symboli są podane w mega symbolach; wprowadź wartość od 2 do 45"

#: ../dmmBlindScan.py:877 ../plugin.py:1298
msgid "The blindscan run was cancelled by the user."
msgstr "Użytkownik anulował operację blindscan."

#: ../plugin.py:616
#, python-format
msgid "The suggested polarisation for this satellite is \"%s\""
msgstr "Sugerowana polaryzacja dla tego satelity to \"%s\""

#: ../dmmBlindScan.py:121
msgid "Transponder searching finished!"
msgstr "Zakończono wyszukiwanie transpondera!"

#: ../dmmBlindScan.py:643 ../plugin.py:569
msgid "Tuner"
msgstr "Tuner"

#: ../dmmBlindScan.py:538
msgid "Use Sundtek full hardware blind scan!"
msgstr "Użyj pełnego, blind scan sprzętu Sundtek!"

#: ../dmmBlindScan.py:682 ../plugin.py:626
msgid "When a neighbouring satellite is very strong this avoids searching transponders known to be coming from the neighbouring satellite."
msgstr "Jeżeli sygnał sąsiedniego satelity jest bardzo silny, pozwala to uniknąć przeszukiwania transponderów, o których wiadomo, że pochodzą z sąsiedniego satelity."

