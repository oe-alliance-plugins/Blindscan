msgid "Scan start frequency"
msgstr "Częstotliwość rozpoczęcia skanowania"

#: ../plugin.py:617
msgid "Scan start symbolrate"
msgstr "Rozpocznij skanowanie symbolrate"

#: ../plugin.py:594 ../plugin.py:597 ../plugin.py:609 ../plugin.py:612
msgid "Scan stop frequency"
msgstr "Częstotliwość zatrzymania skanowania"

