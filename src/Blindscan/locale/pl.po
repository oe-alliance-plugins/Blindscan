msgid "Scan stop symbolrate"
msgstr "Skanowanie zatrzymania symbolrate"

#: ../plugin.py:1290
#, python-format
msgid ""
"Search completed\n"
"%d transponders found in %d:%02d minutes.\n"
"Details saved in: %s"
msgstr ""
"Wyszukiwanie ukończone\n"
"%d transponderów znaleziono w ciągu %d:%02d minut.\n"
"Szczegóły zapisane w: %s"

#: ../dmmBlindScan.py:873
#, python-format
