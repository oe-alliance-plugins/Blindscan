msgid "DVB-S + DVB-S2"
msgstr "DVB-S + DVB-S2"

#: ../dmmBlindScan.py:786
msgid "DVB-S only"
msgstr "Solo DVB-S"

#: ../plugin.py:189
msgid "Deselect all"
msgstr "Deseleziona tutto"

