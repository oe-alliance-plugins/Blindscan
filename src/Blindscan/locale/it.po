#: ../plugin.py:597 ../plugin.py:608 ../plugin.py:609 ../plugin.py:611
#: ../plugin.py:612
#, python-format
msgid "Frequency values must be between %d MHz and %d MHz"
msgstr "I valori di frequenza devono essere compresi tra %d MHz e %d MHz"

#: ../plugin.py:593 ../plugin.py:594
#, python-format
msgid "Frequency values must be between %d MHz and %d MHz (C-band)"
msgstr "I valori di frequenza devono essere compresi tra %d MHz e %d MHz (banda C)"

#: ../dmmBlindScan.py:540
#, python-format
msgid "Hardware blind scan is not supported by this tuner (%s)!"
msgstr "BlindScan hardware non è supportato da questo sintonizzatore (%s)!"

#: ../dmmBlindScan.py:675 ../plugin.py:619
msgid "If you select \"yes\" all channels on the satellite being searched will be deleted before starting the current search, yes (keep feeds) means the same but hold all feed services/transponders."
msgstr "Se selezioni \"sì\", tutti i canali del satellite in fase di ricerca verranno eliminati prima di iniziare la ricerca corrente, \"sì (mantieni feed)\" significa lo stesso ma mantiene tutti i feed servizi/transponder."

#: ../dmmBlindScan.py:676 ../plugin.py:620
msgid "If you select \"yes\" the scan will only save channels that are not encrypted; \"no\" will find encrypted and non-encrypted channels."
msgstr "Se selezioni \"sì\", la scansione salverà solo i canali che non sono crittografati; \"no\" troverà i canali crittografati e non crittografati."

#: ../dmmBlindScan.py:677 ../plugin.py:621
msgid "If you select \"yes\" the scan will only search transponders not listed in satellites.xml"
msgstr "Se selezioni \"sì\", la scansione cercherà solo i transponder non elencati in satellites.xml"

#: ../plugin.py:882
msgid "It seems manufacturer does not support blind scan for this tuner."
msgstr "Sembra che il produttore non supporti BlindScan per questo sintonizzatore."

#: ../plugin.py:599
msgid "LNB inversion"
msgstr "Inversione LNB"

#: ../dmmBlindScan.py:658 ../plugin.py:583
msgid "LNB of current satellite not compatible with plugin"
msgstr "LNB del satellite attuale non compatibile con il plugin"

#: ../plugin.py:1009
msgid ""
"Looking for available transponders.\n"
"This will take a long time, please be patient."
msgstr ""
"Cerco transponder disponibili.\n"
"Ci vorrà molto tempo, per favore sii paziente."

#: ../plugin.py:1292
