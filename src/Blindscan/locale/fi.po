#: ../dmmBlindScan.py:486
msgid ""
"\n"
"A recording is in progress."
msgstr ""
"\n"
"Tallennus on meneillään."

#: ../plugin.py:565
msgid ""
"\n"
"The second slot of this dual tuner may not support blind scan."
msgstr ""
"\n"
"Tämän kaksoisvirittimen toinen paikka ei ehkä tue sokkoskannausta."

#: ../plugin.py:567
msgid ""
"\n"
"You must use the power adapter."
msgstr ""
"\n"
"Sinun on käytettävä virtalähdettä."

#: ../plugin.py:1005
msgid "   Starting Sundtek hardware blind scan."
msgstr "   Käynnistetään Sundtek-laitteiston sokkoskannaus."

#: ../plugin.py:738
msgid " tuner."
msgstr " viritin."

#: ../plugin.py:589
msgid "\"channel scan\" searches for channels and saves them to your receiver; \"transponder scan\" does a transponder search and displays the results allowing user to select some or all transponder. Both options save the results in satellites.xml format under /tmp"
msgstr "\"kanavaskannaus\" etsii kanavia ja tallentaa ne vastaanottimeesi; \"transponderiskannaus\" etsii transpondereita ja näyttää tulokset, jolloin käyttäjä voi valita osan tai kaikki transponderit. Molemmat vaihtoehdot tallentavat tulokset satellites.xml-muodossa /tmp-kansioon"

#: ../dmmBlindScan.py:665
msgid "\"scan for channels\" searches for channels and saves them to your receiver; \"Save to XML\" does a transponder search and saves the results in satellites.xml format and stores it in /tmp"
msgstr "\"skannaa kanavia\" etsii kanavia ja tallentaa ne vastaanottimeesi; \"Tallenna XML-muotoon\" tekee transponderihaun ja tallentaa tulokset satellites.xml-muotoon ja tallentaa ne /tmp-tiedostoon"

#: ../dmmBlindScan.py:347
#, python-format
msgid "%d transponder(s) found"
msgstr "%d transponderi(a) löydetty"

#: ../dmmBlindScan.py:322
#, python-format
msgid "%d transponders found at %d:%02d min"
msgstr "%d transponderia löydetty %d:%02d minuutissa"

#: ../dmmBlindScan.py:352
#, python-format
msgid "%d:%02d/%d:%02dmin"
msgstr "%d:%02d/%d:%02dmin"

#: ../dmmBlindScan.py:320
#, python-format
msgid "%dMHz scanned"
msgstr "%dMHz skannattu"

#: ../dmmBlindScan.py:673
msgid "Accuracy (higher is better)"
msgstr "Tarkkuus (korkeampi on parempi)"

#: ../dmmBlindScan.py:87
msgid "Auto / Manual"
msgstr "Auto / Manuaali"

#: ../plugin.py:1616 ../plugin.py:1625
msgid "Blind scan"
msgstr "Sokkoskannaus"

#: ../dmmBlindScan.py:555
msgid "Blind scan for DVB-S2 tuners"
msgstr "Sokkoskannaus DVB-S2 virittimille"

#: ../dmmBlindScan.py:79 ../plugin.py:158
msgid "Blind scan state"
msgstr "Sokkoskannauksen tila"

#: ../plugin.py:232
msgid "Blindscan"
msgstr "Sokkoskannaus"

#: ../plugin.py:907 ../plugin.py:916 ../plugin.py:946 ../plugin.py:954
#: ../plugin.py:968
#, python-format
msgid "Blindscan executable not found '%s'!"
msgstr "Sokkoskannaus-suoritettavaa tiedostoa ei löydy '%s'!"

#: ../plugin.py:738
msgid "Blindscan is not supported in "
msgstr "Sokkoskannausta ei tueta "

#: ../dmmBlindScan.py:681 ../plugin.py:625
msgid "CAUTION: If you select \"yes\" the scan will not remove \"duplicated\" transponders from the list. Default is \"no\". Only change this if you understand why you are doing it."
msgstr "VAROITUS: Jos valitset \"kyllä\", skannaus ei poista \"duplikaatteja\" transpondereita luettelosta. Oletus on \"ei\". Muuta tätä vain, jos ymmärrät miksi teet sen."

#: ../dmmBlindScan.py:680 ../plugin.py:624
msgid "CAUTION: If you select \"yes\" the scan will not sync with transponders listed in satellites.xml. Default is \"no\". Only change this if you understand why you are doing it."
msgstr "VAROITUS: Jos valitset \"kyllä\", skannaus ei synkronoidu satellites.xml-tiedostossa lueteltujen transpondereiden kanssa. Oletus on \"ei\". Muuta tätä vain, jos ymmärrät miksi teet sen."

#: ../plugin.py:599
msgid "CAUTION: Only select \"inverted\" if you are using an inverted LNB (i.e. an LNB where the local oscillator frequency is greater than the scan frequency). Default is \"normal\". Only change this if you understand why you are doing it."
msgstr "VAROITUS: Valitse \"käänteinen\" vain, jos käytät käänteistä mikropäätä (eli mikropäätä, jossa paikallisoskillaattorin taajuus on suurempi kuin pyyhkäisytaajuus). Oletus on \"normaali\". Muuta tätä vain, jos ymmärrät miksi teet sen."

#: ../dmmBlindScan.py:86 ../plugin.py:163
msgid "Cancel"
msgstr "Peruuta"

#: ../dmmBlindScan.py:675 ../plugin.py:619
msgid "Clear before scan"
msgstr "Tyhjennä ennen skannausta"

#: ../plugin.py:1008
#, python-format
msgid ""
"Current Status: %d/%d\n"
"Satellite: %s\n"
"Polarization: %s  Frequency range: %d - %d MHz  Symbol rates: %d - %d MSym/s"
msgstr ""
"Tilanne: %d/%d\n"
"Satelliitti: %s\n"
"Polarisaatio: %s  Taajuusalue: %d - %d MHz  Symbolinopeudet: %d - %d MSym/s"

#: ../dmmBlindScan.py:785
msgid "DVB-S + DVB-S2"
msgstr "DVB-S + DVB-S2"

#: ../dmmBlindScan.py:786
msgid "DVB-S only"
msgstr "Vain DVB-S"

#: ../plugin.py:189
msgid "Deselect all"
msgstr "Poista kaikki valinnat"

#: ../dmmBlindScan.py:681 ../plugin.py:625
msgid "Disable remove duplicates"
msgstr "Poista käytöstä duplikaattien poisto"

#: ../dmmBlindScan.py:680 ../plugin.py:624
msgid "Disable sync with known transponders"
msgstr "Poista synkronointi käytöstä tunnettujen transpondereiden kanssa"

#: ../dmmBlindScan.py:599 ../plugin.py:306
msgid "Exit"
msgstr "Poistu"

#: ../dmmBlindScan.py:682 ../plugin.py:626
msgid "Filter out adjacent satellites"
msgstr "Suodata naapuri satelliitit pois"

#: ../dmmBlindScan.py:667 ../dmmBlindScan.py:668 ../plugin.py:596
#: ../plugin.py:597 ../plugin.py:608 ../plugin.py:609 ../plugin.py:611
#: ../plugin.py:612
#, python-format
msgid "Frequency values must be between %d MHz and %d MHz"
msgstr "Taajuus pitää olla välillä %d MHz ja %d MHz"

#: ../plugin.py:593 ../plugin.py:594
#, python-format
msgid "Frequency values must be between %d MHz and %d MHz (C-band)"
msgstr "Taajuus pitää olla välillä %d MHz ja %d MHz (C-band)"

#: ../dmmBlindScan.py:540
#, python-format
msgid "Hardware blind scan is not supported by this tuner (%s)!"
msgstr "Tämä viritin (%s) ei tue laitteiston sokkoskannausta!"

#: ../dmmBlindScan.py:675 ../plugin.py:619
msgid "If you select \"yes\" all channels on the satellite being searched will be deleted before starting the current search, yes (keep feeds) means the same but hold all feed services/transponders."
msgstr "Jos valitset \"kyllä\", kaikki etsittävän satelliitin kanavat poistetaan ennen nykyisen haun aloittamista, kyllä (säilytä syötteet) tarkoittaa samaa, mutta säilyttää kaikki syötteen kanavat/transponderit."

#: ../dmmBlindScan.py:676 ../plugin.py:620
msgid "If you select \"yes\" the scan will only save channels that are not encrypted; \"no\" will find encrypted and non-encrypted channels."
msgstr "Jos valitset \"kyllä\", haku tallentaa vain kanavat, joita ei ole salattu; \"ei\" löytää salattuja ja salaamattomia kanavia."

#: ../dmmBlindScan.py:677 ../plugin.py:621
msgid "If you select \"yes\" the scan will only search transponders not listed in satellites.xml"
msgstr "Jos valitset \"kyllä\", skannaus etsii vain transpondereita, joita ei ole lueteltu satelliittis.xml-tiedostossa"

#: ../plugin.py:882
msgid "It seems manufacturer does not support blind scan for this tuner."
msgstr "Näyttää siltä, että valmistaja ei tue sokkoskannausta tälle virittimelle."

#: ../plugin.py:599
msgid "LNB inversion"
msgstr "LNB-inversio"

#: ../dmmBlindScan.py:658 ../plugin.py:583
msgid "LNB of current satellite not compatible with plugin"
msgstr "Nykyisen satelliitin LNB ei ole yhteensopiva pluginin kanssa"

#: ../plugin.py:1009
msgid ""
"Looking for available transponders.\n"
"This will take a long time, please be patient."
msgstr ""
"Etsitään saatavilla olevia transpondereita.\n"
"Tämä kestää kauan, ole kärsivällinen."

#: ../plugin.py:1292
msgid ""
"No new transponders found! \n"
"\n"
"Only transponders already listed in satellites.xml \n"
"have been found for those search parameters!"
msgstr ""
"Uusia transpondereita ei löytynyt! \n"
"\n"
"Näillä hakuparametreilla on löydetty vain \n"
"satellits.xml-tiedostossa jo listattuja transpondereita!"

#: ../dmmBlindScan.py:879 ../plugin.py:1296
msgid "No transponders were found for those search parameters!"
msgstr "Näillä hakuparametreillä ei löytynyt transpondereita!"

#: ../dmmBlindScan.py:532
msgid "Nothing to scan! Press Exit!"
msgstr "Ei mitään skannattavaa! Paina Poistu!"

#: ../dmmBlindScan.py:676 ../plugin.py:620
msgid "Only free scan"
msgstr "Skannaa vain vapaat"

#: ../dmmBlindScan.py:677 ../plugin.py:621
msgid "Only scan unknown transponders"
msgstr "Skannaa vain tuntemattomat transponderit"

#: ../plugin.py:322 ../plugin.py:1439
msgid "Open xml file"
msgstr "Avaa xml-tiedosto"

#: ../dmmBlindScan.py:606 ../plugin.py:315
msgid "Please setup your tuner configuration."
msgstr "Määritä virittimen asetukset."

#: ../plugin.py:616
msgid "Polarisation"
msgstr "Polarisaatio"

#: ../dmmBlindScan.py:669
msgid "Polarisation, select horizontal, vertical or both."
msgstr "Polarisaatio, valitse horisontaali, vertikaali tai molemmat."

#: ../dmmBlindScan.py:669
msgid "Polarization"
msgstr "Polarisaatio"

#: ../dmmBlindScan.py:609
msgid "Press OK to start the scan."
msgstr "Paina OK aloittaaksesi skannauksen."

#: ../dmmBlindScan.py:122
msgid "Press green to start service searching."
msgstr "Paina vihreä aloittaaksesi kanavahaun."

#: ../plugin.py:308 ../plugin.py:1466 ../plugin.py:1476
msgid "Restore defaults"
msgstr "Palauta oletukset"

#: ../dmmBlindScan.py:652 ../plugin.py:577
msgid "Satellite"
msgstr "Satelliitti"

#: ../dmmBlindScan.py:688 ../plugin.py:187 ../plugin.py:311 ../plugin.py:629
msgid "Scan"
msgstr "Skannaa"

#: ../plugin.py:615
msgid "Scan Step in MHz(TBS5925)"
msgstr "Skannausaskel MHz:ssä (TBS5925)"

#: ../plugin.py:1625
msgid "Scan satellites for new transponders"
msgstr "Skannaa satelliiteista uusia transpondereita"

#: ../plugin.py:593 ../plugin.py:596 ../plugin.py:608 ../plugin.py:611
msgid "Scan start frequency"
msgstr "Skannauksen aloitustaajuus"

#: ../plugin.py:617
msgid "Scan start symbolrate"
msgstr "Skannauksen aloitussymbolinopeus"

#: ../plugin.py:594 ../plugin.py:597 ../plugin.py:609 ../plugin.py:612
