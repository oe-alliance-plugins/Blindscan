msgstr "Symbolinopeuden arvot ovat megasymboleissa; syötä arvo välillä %d ja %d"

#: ../plugin.py:617
msgid "Symbol rate values are in megasymbols; enter a value between 1 and 44"
msgstr "Symbolinopeuden arvot ovat megasymboleissa; syötä arvo välillä 1 ja 44"

#: ../plugin.py:618
msgid "Symbol rate values are in megasymbols; enter a value between 2 and 45"
msgstr "Symbolinopeuden arvot ovat megasymboleissa; syötä arvo välillä 2 ja 45"

#: ../dmmBlindScan.py:877 ../plugin.py:1298
