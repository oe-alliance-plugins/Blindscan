"Haku valmis. %d transponderia löytyi.\n"
"\n"
"Tiedot tallennettu:\n"
"%s"

#: ../dmmBlindScan.py:665 ../plugin.py:589
msgid "Search type"
msgstr "Hakutyyppi"

#: ../dmmBlindScan.py:530
msgid "Searching for active satellite transponders..."
msgstr "Haetaan aktiivisia satelliittitranspondereita..."

#: ../dmmBlindScan.py:643 ../plugin.py:569
msgid "Select a tuner that is configured for the satellite you wish to search"
msgstr "Valitse viritin, joka on määritetty satelliitille, jota haluat etsiä"

#: ../plugin.py:188
msgid "Select all"
msgstr "Valitse kaikki"

#: ../dmmBlindScan.py:673
msgid "Select between 1 and 5. Higher numbers give more accurat search results."
msgstr "Valitse väliltä 1 ja 5. Suuremmat luvut antavat tarkempia hakutuloksia."

#: ../dmmBlindScan.py:652 ../plugin.py:577
msgid "Select the satellite you wish to search"
msgstr "Valitse satelliitti, jota haluat etsiä"

#: ../plugin.py:186
msgid ""
"Select transponders and press green to scan.\n"
"Press yellow to select all transponders and blue to deselect all."
msgstr ""
"Valitse transponderit ja skannaa painamalla vihreää.\n"
"Paina keltaista valitaksesi kaikki transponderit ja sinistä poistaaksesi kaikki valinnat."

#: ../dmmBlindScan.py:114
msgid "Service searching to be started MANUALLY by the user. To change this press green."
msgstr "Kanavahaku käynnistetään käyttäjän toimesta MANUAALISESTI. Voit muuttaa tätä painamalla vihreää."

#: ../dmmBlindScan.py:116
msgid "Service searching will start AUTOMATICALLY. To change this press green."
msgstr "Kanavahaku alkaa AUTOMAATTISESTI. Voit muuttaa tätä painamalla vihreää."

#: ../plugin.py:615
msgid "Smaller steps takes longer but scan is more thorough"
msgstr "Pienemmät askeleet vievät kauemmin, mutta skannaus on perusteellisempaa"

#: ../dmmBlindScan.py:484 ../plugin.py:440
msgid "Sorry, this tuner is in use."
msgstr "Tämä viritin on käytössä."

#: ../dmmBlindScan.py:667
msgid "Start frequency"
msgstr "Aloitustaajuus"

#: ../dmmBlindScan.py:670
msgid "Start symbol rate"
msgstr "Aloitus symbolinopeus"

