msgstr "Skannauksen lopetustaajuus"

#: ../plugin.py:618
msgid "Scan stop symbolrate"
msgstr "Skannauksen lopetussymbolinopeus"

#: ../plugin.py:1290
#, python-format
msgid ""
"Search completed\n"
"%d transponders found in %d:%02d minutes.\n"
"Details saved in: %s"
msgstr ""
"Haku valmis\n"
"%d transponderia löytyi %d:%02d minuutissa.\n"
"Tiedot tallennettu: %s"

#: ../dmmBlindScan.py:873
#, python-format
